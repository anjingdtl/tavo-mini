{
  "name": "ShineWriter",
  "version": "2.9.3",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "prebuild": "node scripts/generate-version-json.js",
    "apk:debug": "npm run prebuild && node scripts/build-apk.js debug",
    "apk:release": "npm run prebuild && node scripts/build-apk.js release",
    "apk:release:minified": "npm run prebuild && node scripts/build-apk.js release --minify",
    "ios": "react-native run-ios",
    "zspace:probe": "node scripts/zspace-webdav.mjs probe",
    "zspace:list": "node scripts/zspace-webdav.mjs list",
    "zspace:put": "node scripts/zspace-webdav.mjs put",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:ci": "jest --runInBand --ci",
    "test:coverage": "jest --runInBand --ci --coverage",
    "verify:version": "node scripts/check-version-consistency.js",
    "verify": "npm run lint && npm run typecheck && npm run verify:version && npm run test:ci",
    "postinstall": "node scripts/patch-sqlite-storage-gradle.js && node scripts/patch-deps.js",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "@types/pako": "^2.0.4",
    "lucide-react-native": "^1.16.0",
    "pako": "^2.1.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-fs": "^2.20.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.15.5",
    "react-native-toast-message": "^2.3.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "codegenConfig": {
    "name": "ShineWriterSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.shinewriter.specs"
    }
  }
}
